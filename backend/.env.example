DATABASE_URL="postgres://user:password@host:port/database"
JWT_SECRET="your-jwt-secret"
PORT=3333

# Webhooks n8n - Configurar URLs para integração com n8n
# Opção 1: URL única (mais simples)
# WEBHOOK_N8N_URL=https://seu-n8n.com/webhook/stoklink

# Opção 2: Múltiplas URLs (Teste + Produção) - Envia para todas simultaneamente
WEBHOOK_N8N_URL_TESTE=https://n8n-n8n.tbs25p.easypanel.host/webhook-test/41d57072-8c26-487c-ba5a-0e751060e8fe
WEBHOOK_N8N_URL_PRODUCAO=https://n8n-n8n.tbs25p.easypanel.host/webhook/41d57072-8c26-487c-ba5a-0e751060e8fe

# Opção 3: URLs separadas por evento (mais organizado)
# WEBHOOK_N8N_NOTA_CRIADA=https://seu-n8n.com/webhook/nota-criada
# WEBHOOK_N8N_NOTA_CONFERIDA=https://seu-n8n.com/webhook/nota-conferida
# WEBHOOK_N8N_NOTA_BLOQUEADA=https://seu-n8n.com/webhook/nota-bloqueada
# WEBHOOK_N8N_DIVERGENCIA_DETECTADA=https://seu-n8n.com/webhook/divergencia-detectada
# WEBHOOK_N8N_NOTA_EXCLUIDA=https://seu-n8n.com/webhook/nota-excluida
